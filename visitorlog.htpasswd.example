# Example admin credential file for the /admin page.
#
# This is a TEMPLATE — do NOT put real credentials here (this file is in git).
# The real file lives at /etc/lighttpd/visitorlog.htpasswd and is gitignored.
#
# Format: one "username:hash" per line. Generate a SHA-512 crypt hash with:
#
#     printf 'admin:%s\n' "$(openssl passwd -6)" | sudo tee /etc/lighttpd/visitorlog.htpasswd
#     sudo chown root:www-data /etc/lighttpd/visitorlog.htpasswd
#     sudo chmod 0640 /etc/lighttpd/visitorlog.htpasswd
#     sudo systemctl reload lighttpd
#
# Add more lines for more admin users.
admin:$6$EXAMPLEEXAMPLE$REPLACE.WITH.OUTPUT.OF.openssl.passwd.-6................................
